{% extends 'base.html.twig' %}

{% block title %}{{ race.Name }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .race-image {
            max-width: 300px;
            border-radius: 1rem;
            object-fit: cover;
        }

        .race-description {
            white-space: pre-line;
        }

        .info-label {
            font-weight: bold;
        }

        @media (max-width: 768px) {
            .race-flex {
                flex-direction: column;
                align-items: center;
            }
        }
    </style>
{% endblock %}

{% block body %}
<div class="container text-white my-5">
    <a href="{{ path('app_races', { worldId: race.RaceWorld.id }) }}" class="btn btn-outline-light mb-4">
        ← Back to list
    </a>

    <div class="row g-4 align-items-start race-flex">
        {# Image à gauche #}
        <div class="col-md-4 text-center">
            {% if race.ImageRace %}
                <img src="{{ asset('uploads/races/' ~ race.ImageRace) }}" alt="{{ race.Name }}" class="race-image">
            {% endif %}
        </div>

        {# Infos à droite #}
        <div class="col-md-8">
            <h2 class="text-info fw-bold">{{ race.Name }}</h2>

            <p class="race-description">
                <span class="info-label">Description :</span><br>
                {{ race.Description ?: 'Aucune description fournie.' }}
            </p>

            <p class="mt-3">
                <span class="info-label">Nombre de héros associés :</span>
                {{ race.RaceHero|length }}
            </p>

            {% if race.RaceHero|length > 0 %}
                <ul class="list-group bg-dark text-white">
                    {% for hero in race.RaceHero %}
                        <li class="list-group-item bg-dark text-white">
                            <a href="{{ path('app_hero_show', { id: hero.id }) }}" class="text-info">
                                {{ hero.Name }}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
