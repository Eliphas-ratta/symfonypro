{% extends 'base.html.twig' %}

{% block title %}Privacy Policy{% endblock %}

{% block body %}
<div class="container text-white py-5">
    <h1 class="mb-4">Privacy Policy</h1>
    <p>This website does not collect any personal information from visitors.</p>
    <p>No tracking cookies or analytics tools are used. Only essential cookies may be stored to improve user experience (e.g., theme preferences).</p>
    <p>If you create an account, your information is only stored to allow access to features such as saving your content or managing your fantasy world.</p>
    <p>Your data is never shared with third parties and can be deleted at your request by contacting the site owner.</p>
    <p>By using this site, you agree to this privacy policy.</p>
</div>
{% endblock %}
